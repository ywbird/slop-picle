{
  "picle": 1,
  "settings": { "width": 48, "height": 32, "frames": 1, "fps": 12 },
  "nodes": {
    "sky": {
      "type": "gradient",
      "label": "dusk sky",
      "inputs": {
        "angle": 90,
        "gradient": { "type": "rgb", "keys": [{ "time": 0, "color": "#1a1c2c" }, { "time": 0.6, "color": "#5d275d" }, { "time": 1, "color": "#ef7d57" }] }
      }
    },
    "sky_dither": {
      "type": "dither",
      "inputs": { "surface_in": { "ref": "sky" }, "palette": ["#1a1c2c", "#5d275d", "#b13e53", "#ef7d57"] }
    },
    "sun": {
      "type": "shape",
      "inputs": { "shape": "ellipse", "dimension": [12, 12], "shape_color": "#ffcd75" }
    },
    "sun_ring": {
      "type": "outline",
      "inputs": { "surface_in": { "ref": "sun" }, "width": 1, "profile": "square", "color": "#f4f4f4" }
    },
    "scene": {
      "type": "blend",
      "inputs": { "background": { "ref": "sky_dither" }, "foreground": { "ref": "sun_ring" }, "position": [0.7, 0.45] }
    },
    "ground": {
      "type": "stripe",
      "inputs": { "dimension": [48, 8], "angle": 45, "size": 0.5, "color_1": "#257179", "color_2": "#38b764" }
    },
    "final": {
      "type": "blend",
      "inputs": { "background": { "ref": "scene" }, "foreground": { "ref": "ground" }, "position": [0.5, 0.875] }
    },
    "out": { "type": "output", "inputs": { "surface_in": { "ref": "final" } } }
  }
}
